{
  "$schema": "https://raw.githubusercontent.com/nexus-ai-2045/repo-preflight/f825268978228a3cfb2f5ecba16a74d424134b1a/schemas/repository-consistency.schema.json",
  "schema": "repo-preflight.consistency/v1",
  "mode": "shadow",
  "ratchet": {"baseline": []},
  "markdown": {
    "include": [
      "README.md",
      "CONTRIBUTING.md",
      "PREFLIGHT.md",
      "SECURITY.md",
      "docs/**/*.md"
    ]
  },
  "readme_contracts": {
    "required_paths": [
      "roundtable/cli.py",
      "roundtable/doctor.py",
      "docs/DESIGN.md",
      "docs/PROTOCOL.md",
      "docs/ROADMAP.md",
      "tests/test_version_consistency.py"
    ],
    "commands": [
      {
        "text": "python -m roundtable.cli doctor",
        "paths": ["roundtable/cli.py", "roundtable/doctor.py"]
      },
      {
        "text": "ai-roundtable --help",
        "paths": ["roundtable/cli.py"]
      }
    ]
  },
  "impact_map": [
    {
      "change": ["roundtable/**", "tests/**"],
      "requires_any": ["README.md", "docs/**", "tests/**"]
    },
    {
      "change": [
        ".github/workflows/**",
        ".repo-preflight-consistency.json",
        ".ai-ratchet-gate/**",
        "requirements-tools.txt"
      ],
      "requires_any": ["README.md", "CONTRIBUTING.md", "PREFLIGHT.md"],
      "allow_github_action_ref_updates": true
    }
  ],
  "generated_artifacts": []
}
